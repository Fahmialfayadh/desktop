# Local development default: http://localhost:1337
# Production default: https://api.tryliner.fun (or custom instance)
VITE_API_URL=http://localhost:1337
VITE_COVERS_PROXY_URL=https://covers.tryliner.fun
LINER_DEV_SIGNING_SECRET=

# Supabase Configuration (Auth + Personal Metadata Sync)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Personal Audio Stream & CORS Gateway URL
VITE_STREAM_GATEWAY_URL=http://localhost:8787

# Optional Backend Gateway Runtime Settings
PORT=8787
HOST=0.0.0.0
TMP_STREAM_DIR=/tmp/liner-stream-cache
CORS_ALLOW_ORIGINS=*
